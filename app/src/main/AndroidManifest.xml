<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SasoBakeryApp"
        tools:targetApi="31">

        <!-- Splash: es la pantalla de arranque de la app (después abre el login) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SasoBakeryApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Inicio de sesión (se abre desde el splash) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Recuperación de contraseña (se abre desde el login) -->
        <activity
            android:name=".RecuperarClaveActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla provisional de selección de rol: se abre desde el login (solo pruebas) -->
        <activity
            android:name=".RolSeleccionActivity"
            android:exported="false" />

        <!-- Panel general del administrador -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".PedidosActivity"
            android:exported="false" />
        <activity
            android:name=".CategoriasActivity"
            android:exported="false" />
        <activity
            android:name=".ProductosCategoriasActivity"
            android:exported="false" />
        <activity
            android:name=".UsuariosRolesActivity"
            android:exported="false" />

        <activity
            android:name=".UsuariosRolesActivity"
            android:exported="false" />
        <!-- Invitar usuario: registro con nombre, correo y rol (administrador) -->
        <activity
            android:name=".UsuarioFormularioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Vendedor -->
        <activity
            android:name=".VendedorPrincipalActivity"
            android:exported="false" />
        <activity
            android:name=".ProductosInventarioActivity"
            android:exported="false" />
        <!-- Crear o editar producto (vendedor) -->
        <activity
            android:name=".ProductoFormularioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Gestión de pedidos (vendedor) -->
        <activity
            android:name=".PedidosVendedorActivity"
            android:exported="false" />
        <!-- Perfil del vendedor -->
        <activity
            android:name=".PerfilVendedorActivity"
            android:exported="false" />

        <!-- Comprador -->
        <!-- Inicio y catálogo del comprador -->
        <activity
            android:name=".CatalogoCompradorActivity"
            android:exported="false" />
        <!-- Detalle del producto (comprador) -->
        <activity
            android:name=".ProductoDetalleActivity"
            android:exported="false" />
        <!-- Carrito del comprador -->
        <activity
            android:name=".CarritoCompradorActivity"
            android:exported="false" />
        <!-- Entrega o recojo (comprador) -->
        <activity
            android:name=".EntregaCompradorActivity"
            android:exported="false" />
        <!-- Método de pago (comprador) -->
        <activity
            android:name=".PagoCompradorActivity"
            android:exported="false" />
        <!-- Confirmación y seguimiento del pedido (comprador) -->
        <activity
            android:name=".PedidoConfirmadoActivity"
            android:exported="false" />
        <!-- Perfil e historial (comprador) -->
        <activity
            android:name=".PerfilCompradorActivity"
            android:exported="false" />
        <activity
            android:name=".MisPedidosCompradorActivity"
            android:exported="false" />
        <activity
            android:name=".FavoritosCompradorActivity"
            android:exported="false" />
    </application>

</manifest>