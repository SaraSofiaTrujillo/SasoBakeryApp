<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBFF"
    tools:context=".PedidoConfirmadoActivity">

    <!-- ===== CABECERA LILA (llega hasta arriba de la pantalla) ===== -->
    <LinearLayout
        android:id="@+id/cabecera"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#F1EAFA"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <FrameLayout
                android:id="@+id/btnAtras"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_users_input"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#5D477F" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#2E2340"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Pedido #SB-1051" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCheck"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_users_avatar"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:textColor="#7B5EA7"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="✓" />

        <TextView
            android:id="@+id/tvConfirmado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="#2E2340"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="¡Pedido confirmado!" />

        <TextView
            android:id="@+id/tvLlegada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#6B6478"
            android:textSize="12sp"
            tools:text="Tu pedido llegará mañana entre 12:00 y 14:00" />
    </LinearLayout>

    <!-- ===== CONTENIDO CON SCROLL ===== -->
    <ScrollView
        android:id="@+id/scrollSeguimiento"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecera">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Estado actual -->
            <LinearLayout
                android:id="@+id/cardEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pedidos_stat"
                android:backgroundTint="#FBEFD0"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="ESTADO DEL PEDIDO"
                        android:textColor="#B7791F"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstadoActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#2E2340"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="En preparación" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTipoEntrega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7B5EA7"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="A domicilio" />
            </LinearLayout>

            <!-- Línea de tiempo (se llena desde Kotlin) -->
            <LinearLayout
                android:id="@+id/layoutPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <!-- Dirección -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_users_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_catalogo_manage">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home"
                        android:tint="#7B5EA7" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDireccionEtiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:textColor="#8A8494"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="DIRECCIÓN DE ENTREGA" />

                    <TextView
                        android:id="@+id/tvDireccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#2E2340"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Cra 10 # 20-30, Apto 302" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ayuda -->
            <TextView
                android:id="@+id/btnAyuda"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_users_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Necesito ayuda"
                android:textColor="#5D477F"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>