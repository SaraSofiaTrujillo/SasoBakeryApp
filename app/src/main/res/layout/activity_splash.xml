<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/saso_lavanda"
    tools:context=".SplashActivity">

    <!-- Círculos decorativos (mismos colores del login) -->
    <View
        android:id="@+id/circuloRosa"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_users_avatar"
        android:backgroundTint="#FBE0E5"
        android:translationX="-70dp"
        android:translationY="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/circuloLila"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_users_avatar"
        android:backgroundTint="#DCCFF1"
        android:translationX="90dp"
        android:translationY="-80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/circuloBlanco"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_users_avatar"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo: queda exactamente en el centro, igual que el del splash del sistema -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:background="@drawable/bg_users_logo"
        android:contentDescription="Logo de Saso Bakery"
        android:padding="27dp"
        android:src="@drawable/ic_logo_mark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="serif"
        android:text="Saso"
        android:textColor="#2E2340"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSplashLogo" />

    <TextView
        android:id="@+id/tvBakery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.3"
        android:text="BAKERY"
        android:textColor="#8A8494"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSaso" />

    <TextView
        android:id="@+id/tvLema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="Hecho con cariño,\npara tus momentos favoritos."
        android:textColor="#5D477F"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>