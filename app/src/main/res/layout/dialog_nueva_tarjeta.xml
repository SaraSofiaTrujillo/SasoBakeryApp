<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Nueva tarjeta"
            android:textColor="#2E2340"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Número de tarjeta"
            android:textColor="#2E2340"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etTarjetaNumero"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_users_input"
            android:hint="Solo números"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="19"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#2E2340"
            android:textColorHint="#8A8494"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Vencimiento"
            android:textColor="#2E2340"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etTarjetaVence"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_users_input"
            android:digits="0123456789/"
            android:hint="MM/AA"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="5"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#2E2340"
            android:textColorHint="#8A8494"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Solo guardamos los últimos 4 dígitos. Esta versión es una demostración: no se procesan pagos reales."
            android:textColor="#8A8494"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelarTarjeta"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_users_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#5D477F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGuardarTarjeta"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_users_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Agregar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>