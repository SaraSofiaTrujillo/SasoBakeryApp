<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1EAFA"
    tools:context=".RecuperarClaveActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== ZONA LILA: volver + logo ===== -->
            <FrameLayout
                android:id="@+id/headerRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <!-- Círculos decorativos (los mismos del login) -->
                <View
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-40dp"
                    android:layout_marginBottom="-20dp"
                    android:background="@drawable/bg_users_avatar"
                    android:backgroundTint="#FBE0E5" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="-30dp"
                    android:background="@drawable/bg_users_avatar"
                    android:backgroundTint="#DCCFF1" />

                <FrameLayout
                    android:id="@+id/btnAtras"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_users_input"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volver"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="#5D477F" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_users_logo"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_logo_mark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="serif"
                        android:text="Saso"
                        android:textColor="#2E2340"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BAKERY"
                        android:textColor="#8A8494"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== PANEL BLANCO: 4 pasos (se muestra uno a la vez) ===== -->
            <LinearLayout
                android:id="@+id/panelRecuperar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_panel"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- PASO 1: correo -->
                <LinearLayout
                    android:id="@+id/paso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="#2E2340"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No te preocupes. Escribe el correo de tu cuenta y te enviaremos un código de 6 dígitos para crear una nueva."
                        android:textColor="#8A8494"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Correo electrónico"
                        android:textColor="#2E2340"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_users_stats"
                        android:hint="tucorreo@email.com"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#2E2340"
                        android:textColorHint="#8A8494"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnEnviarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_users_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Enviar código"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVolverLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="Volver a iniciar sesión"
                        android:textColor="#7B5EA7"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASO 2: código -->
                <LinearLayout
                    android:id="@+id/paso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Revisa tu correo"
                        android:textColor="#2E2340"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreoEnviado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#8A8494"
                        android:textSize="12sp"
                        tools:text="Si el correo va***@gmail.com tiene una cuenta, le enviamos un código de 6 dígitos." />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Código de verificación"
                        android:textColor="#2E2340"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_users_stats"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:hint="······"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textColor="#2E2340"
                        android:textColorHint="#C9C1D6"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVerificarCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_users_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Verificar código"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReenviar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:textColor="#8A8494"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Reenviar código en 30 s" />

                    <TextView
                        android:id="@+id/btnCambiarCorreo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="Usar otro correo"
                        android:textColor="#7B5EA7"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Aviso de pruebas: se borra cuando exista el envío real de correos -->
                    <TextView
                        android:id="@+id/tvNotaPrueba"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_catalogo_manage"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="Modo prueba: todavía no se envían correos. Usa el código 123456."
                        android:textColor="#5D477F"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- PASO 3: nueva contraseña -->
                <LinearLayout
                    android:id="@+id/paso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Crea tu nueva contraseña"
                        android:textColor="#2E2340"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Debe tener al menos 6 caracteres."
                        android:textColor="#8A8494"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Nueva contraseña"
                        android:textColor="#2E2340"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_users_stats"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etClaveNueva"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Nueva contraseña"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="8dp"
                            android:textColor="#2E2340"
                            android:textColorHint="#8A8494"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnMostrarNueva"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="14dp"
                            android:text="Mostrar"
                            android:textColor="#7B5EA7"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Confirma tu contraseña"
                        android:textColor="#2E2340"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_users_stats"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etClaveConfirmar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Repite la contraseña"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="8dp"
                            android:textColor="#2E2340"
                            android:textColorHint="#8A8494"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnMostrarConfirmar"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="14dp"
                            android:text="Mostrar"
                            android:textColor="#7B5EA7"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnGuardarClave"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_users_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Guardar contraseña"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASO 4: listo -->
                <LinearLayout
                    android:id="@+id/paso4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_users_avatar"
                        android:backgroundTint="#D9F0E3">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check"
                            android:tint="#3F7D5A" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="serif"
                        android:text="¡Contraseña actualizada!"
                        android:textColor="#2E2340"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Ya puedes iniciar sesión con tu nueva contraseña."
                        android:textColor="#8A8494"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnIrLogin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_users_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Volver a iniciar sesión"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
